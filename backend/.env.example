# Copy this file to .env and fill in your values
# cp .env.example .env

DEBUG=False
SECRET_KEY=your-very-secret-key-change-this
ALLOWED_HOSTS=your-server-ip,your-domain.com,localhost,127.0.0.1

# SMTP Email Settings (A2 Hosting Webmail / cPanel SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.astratechnologies.in
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=sales@astratechnologies.in
EMAIL_HOST_PASSWORD=your-email-password-here
DEFAULT_FROM_EMAIL=sales@astratechnologies.in
RECIPIENT_EMAIL=sales@astratechnologies.in

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

